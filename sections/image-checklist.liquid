<div class="section image-checklist{% if section.settings.color_scheme == 'alt' %} surface-alt{% endif %}">
  <div class="page-width">
    <div class="image-checklist__grid image-checklist__grid--{{ section.settings.layout }}">
      <div class="image-checklist__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '450, 700, 900, 1200', sizes: '(min-width: 750px) 45vw, 100vw', alt: section.settings.image.alt | escape
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-checklist__content">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="image-checklist__heading">{{ section.settings.heading }}</h2>{%- endif -%}

        <ul class="checklist checklist--{{ section.settings.marker_style }} image-checklist__list" role="list">
          {%- for block in section.blocks -%}
            <li class="checklist__item" {{ block.shopify_attributes }}>
              <span class="checklist__marker">{% render 'icon', name: section.settings.icon, size: 15 %}</span>
              <span class="checklist__text">
                {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong> {% endif -%}
                {{ block.settings.text }}
              </span>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.closing_text != blank -%}
          <div class="rte image-checklist__closing">{{ section.settings.closing_text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--dark">
            {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 16 %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .image-checklist__grid { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; }
  @media (min-width: 750px) {
    .image-checklist__grid { grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 3.5rem); }
    .image-checklist__grid--right .image-checklist__media { order: 2; }
  }
  .image-checklist__media img,
  .image-checklist__media .placeholder-svg {
    width: 100%;
    border-radius: var(--border-radius);
    border: 1px solid rgb(var(--color-line));
  }
  .image-checklist__heading {
    color: rgb(var(--color-primary));
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid rgb(var(--color-primary) / 0.35);
  }
  .image-checklist__list { margin-bottom: 1.25rem; }
  .image-checklist__list.checklist { display: flex; flex-direction: column; background: none; border: 0; gap: 0.15rem; }
  .image-checklist__list .checklist__item { background: none; padding: 0.55rem 0; }
  .image-checklist__closing { margin-bottom: 1.25rem; color: rgb(var(--color-text) / 0.72); }
  .image-checklist__content .button { margin-top: 0.5rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with checklist",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "layout", "label": "Image position", "default": "left",
      "options": [
        { "value": "left", "label": "Image left" },
        { "value": "right", "label": "Image right" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We have state of the art tooling, machines and equipment to assist us in:" },
    {
      "type": "select", "id": "icon", "label": "List icon", "default": "check",
      "options": [
        { "value": "check", "label": "Check" },
        { "value": "spark", "label": "Spark" },
        { "value": "wrench", "label": "Wrench" },
        { "value": "gear", "label": "Gear" },
        { "value": "shield", "label": "Shield" }
      ]
    },
    {
      "type": "select", "id": "marker_style", "label": "Marker style", "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid black" },
        { "value": "tint", "label": "Red tint" }
      ]
    },
    { "type": "richtext", "id": "closing_text", "label": "Closing text", "info": "Shown below the list" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "color_scheme", "label": "Background", "default": "default",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Light grey" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Lead-in (optional, bold)" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "List item" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with checklist",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
