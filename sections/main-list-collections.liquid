<div class="section list-collections">
  <div class="page-width">
    <header class="section-heading">
      <h1>{{ section.settings.heading | default: 'Collections' }}</h1>
    </header>

    <div class="list-collections__grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-card">
          <div class="collection-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 750px) 33vw, 100vw', alt: collection.title | escape }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
            {%- endif -%}
          </div>
          <h2 class="collection-card__title">{{ collection.title }}</h2>
          <span class="collection-card__count">{{ 'collections.general.items_with_count' | t: count: collection.products_count }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .list-collections__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 750px) {
    .list-collections__grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
  .collection-card { text-decoration: none; color: inherit; }
  .collection-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--border-radius);
    background: rgb(var(--color-text) / 0.06);
  }
  .collection-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .collection-card:hover .collection-card__media img { transform: scale(1.05); }
  .collection-card__title { margin: 0.75rem 0 0.15rem; font-size: 1.1rem; }
  .collection-card__count { font-size: 0.82rem; color: rgb(var(--color-text) / 0.6); }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ],
  "tag": "section"
}
{% endschema %}
