<div class="password-page surface-dark">
  <div class="page-width password-page__inner">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 320 | image_tag: class: 'password-page__logo', alt: settings.brand_name | default: shop.name | escape }}
    {%- else -%}
      <h1 class="password-page__shop">{{ settings.brand_name | default: shop.name }}</h1>
    {%- endif -%}

    <p class="password-page__message">
      {{ section.settings.message | default: shop.password_message | default: 'Opening soon. Enter the password to preview the store.' }}
    </p>

    {% form 'storefront_password', class: 'password-form' %}
      {%- if form.errors -%}
        <p class="form-status form-status--error" data-form-status>{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
      <label class="visually-hidden" for="Password">Password</label>
      <div class="password-form__row">
        <input type="password" name="password" id="Password" placeholder="Password" required>
        <button type="submit" class="button button--primary">Enter</button>
      </div>
    {% endform %}

    <div class="password-page__contact">
      {%- if settings.business_phone != blank -%}<a href="tel:{{ settings.business_phone | remove: ' ' }}">{{ settings.business_phone }}</a>{%- endif -%}
      {%- if settings.business_email != blank -%}<a href="mailto:{{ settings.business_email }}">{{ settings.business_email }}</a>{%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .password-page { min-height: 100vh; display: flex; align-items: center; }
  .password-page__inner { max-width: 30rem; margin-inline: auto; text-align: center; padding-block: 4rem; }
  .password-page__logo { max-width: 14rem; margin: 0 auto 2rem; }
  .password-page__shop { margin-bottom: 1rem; }
  .password-page__message { color: rgb(255 255 255 / 0.75); margin-bottom: 2rem; }
  .password-form__row { display: flex; gap: 0.5rem; }
  .password-form__row input { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.25); color: #fff; }
  .password-page__contact { display: flex; gap: 1rem; justify-content: center; margin-top: 2rem; font-size: 0.9rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "message", "label": "Message" }
  ]
}
{% endschema %}
