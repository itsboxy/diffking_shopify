<div class="hero hero--{{ section.settings.height }}{% if section.settings.image == blank %} hero--no-image{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt | escape
      }}
      <span class="hero__overlay" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }}"></span>
    </div>
  {%- endif -%}

  <div class="page-width hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link | default: '#' }}" class="button button--primary">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#' }}" class="button button--secondary button--on-dark">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    color: #fff;
    background: rgb(var(--color-dark));
    overflow: hidden;
  }
  .hero--small { min-height: 42vh; }
  .hero--medium { min-height: 62vh; }
  .hero--large { min-height: 82vh; }
  .hero--no-image { color: #fff; }

  .hero__media { position: absolute; inset: 0; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .hero__overlay { position: absolute; inset: 0; background: rgb(var(--color-dark)); }

  .hero__content { position: relative; padding-block: 4rem; max-width: 46rem; }
  .hero__eyebrow {
    display: inline-block;
    font-family: var(--font-heading), sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--color-primary));
    margin-bottom: 1rem;
  }
  .hero__heading {
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1.05;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .hero__text { font-size: 1.1rem; color: rgb(255 255 255 / 0.85); max-width: 40ch; margin-bottom: 2rem; }
  .hero__actions { display: flex; gap: 0.85rem; flex-wrap: wrap; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.image"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:sections.hero.overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.height",
      "default": "large",
      "options": [
        { "value": "small", "label": "t:options.height.small" },
        { "value": "medium", "label": "t:options.height.medium" },
        { "value": "large", "label": "t:options.height.large" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow",
      "default": "Melbourne workshop • Shipping Australia-wide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.heading",
      "default": "One stop differential service solution"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.hero.text",
      "default": "Diff repairs, servicing, 9″ conversions, custom axles and fabrication — built by specialists."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.hero.primary_label",
      "default": "Book a service"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:sections.hero.primary_link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.hero.secondary_label",
      "default": "Shop parts"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.hero.secondary_link"
    }
  ],
  "presets": [{ "name": "t:sections.hero.name" }]
}
{% endschema %}
