{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  elsif section.settings.asset_image != blank
    assign has_image = true
  endif
  assign fx = section.settings.bg_effect | default: 'none'
-%}

<section class="hero hero--{{ section.settings.height }}{% unless has_image %} hero--flat{% endunless %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media" data-hero-effect="{{ fx }}" data-section-media data-effect="{{ fx }}">
      {{
        section.settings.image
        | image_url: width: 2600
        | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2600', sizes: '100vw', alt: section.settings.image.alt | escape
      }}
    </div>
  {%- elsif section.settings.asset_image != blank -%}
    <div class="hero__media" data-hero-effect="{{ fx }}" data-section-media data-effect="{{ fx }}">
      <img src="{{ section.settings.asset_image | asset_url }}" alt="" width="1920" height="600" loading="eager" fetchpriority="high">
    </div>
  {%- endif -%}
  <span class="hero__scrim" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}"></span>

  <div class="page-width hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link | default: '#' }}" class="button button--primary">
            {{ section.settings.primary_label }} {% render 'icon', name: 'arrow-right', size: 16 %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#' }}" class="button button--secondary button--on-dark">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="hero__trust" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'icon', name: block.settings.icon, size: 18 %}
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    color: #fff;
    background: rgb(var(--color-dark));
    overflow: hidden;
    isolation: isolate;
  }
  .hero--slim { min-height: 0; align-items: center; }
  .hero--small { min-height: 42vh; }
  .hero--medium { min-height: 58vh; }
  .hero--large { min-height: min(82vh, 760px); }

  /* Slim: a compact bar, eyebrow + one line + buttons, then straight to content */
  .hero--slim.hero--flat {
    color: rgb(var(--color-text));
    background:
      radial-gradient(120% 120% at 100% 0%, rgb(var(--color-primary) / 0.07) 0%, transparent 55%),
      rgb(var(--color-surface));
    border-top: 1px solid rgb(var(--color-line));
    border-bottom: 3px solid rgb(var(--color-primary));
  }
  .hero--slim .hero__content {
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    max-width: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .hero--slim .hero__scrim { display: none; }
  .hero--slim .eyebrow { margin: 0; }
  .hero--slim .hero__heading {
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    line-height: 1.1;
    margin: 0;
  }
  .hero--slim .hero__text,
  .hero--slim .hero__trust { display: none; }
  .hero--slim .hero__actions { margin-top: 0.35rem; }
  @media (min-width: 900px) {
    .hero--slim .hero__content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem 2rem;
    }
    .hero--slim .hero__heading { flex: 1 1 auto; }
    .hero--slim .eyebrow { order: -1; flex-basis: 100%; }
  }

  /* Flat (no image): light, content-driven height, left aligned, subtle accent */
  .hero--flat {
    align-items: center;
    min-height: 0;
    color: rgb(var(--color-text));
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(var(--color-primary) / 0.06) 0%, transparent 55%),
      rgb(var(--color-surface));
    border-top: 1px solid rgb(var(--color-line));
    border-bottom: 1px solid rgb(var(--color-line));
  }
  .hero--flat .hero__content { border-left: 3px solid rgb(var(--color-primary)); padding-left: 1.75rem; }
  .hero--flat .hero__heading { color: rgb(var(--color-text)); }
  .hero--flat .hero__text { color: rgb(var(--color-text) / 0.7); }
  .hero--flat .button--secondary.button--on-dark {
    color: rgb(var(--color-text));
    border-color: rgb(var(--color-text) / 0.22);
  }
  .hero--flat .button--secondary.button--on-dark:hover {
    background: rgb(var(--color-text)); color: rgb(var(--color-background)); border-color: rgb(var(--color-text));
  }
  @media (min-width: 750px) {
    .hero--flat .hero__content { padding-left: 2.5rem; }
  }

  .hero__media { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center; will-change: transform, opacity; }
  .hero__media[data-effect="parallax-up"] img,
  .hero__media[data-effect="fixed"] img { position: relative; top: -14%; height: 128%; }
  .hero__media[data-effect="fade"] img { opacity: var(--fade, 0); transition: opacity 0.1s linear; }
  @media (prefers-reduced-motion: reduce) {
    .hero__media img { position: static !important; top: 0 !important; height: 100% !important; transform: none !important; opacity: 1 !important; }
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgb(var(--color-darker) / 0.35) 0%, rgb(var(--color-darker) / calc(var(--overlay, 0.55) + 0.25)) 100%),
      linear-gradient(90deg, rgb(var(--color-darker) / var(--overlay, 0.55)) 0%, rgb(var(--color-darker) / 0.15) 65%);
  }
  .hero--flat .hero__scrim { background: none; }

  .hero__content { position: relative; padding-block: clamp(3.5rem, 8vw, 6rem); max-width: 52rem; }
  .hero__heading {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }
  .hero__text {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: rgb(255 255 255 / 0.85);
    max-width: 42ch;
    margin-bottom: 2rem;
  }
  .hero__actions { display: flex; gap: 0.85rem; flex-wrap: wrap; }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 2.5rem 0 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }
  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading), sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.9);
  }
  .hero__trust svg { color: rgb(var(--color-primary)); flex-shrink: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.hero.image" },
    { "type": "text", "id": "asset_image", "label": "Bundled image file", "info": "Used when no image is picked above. Filename of an image in assets/ (e.g. hero-diffs.jpg)" },
    { "type": "range", "id": "overlay", "label": "t:sections.hero.overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    {
      "type": "select", "id": "bg_effect", "label": "Image scroll effect", "default": "none",
      "options": [
        { "value": "none", "label": "Static" },
        { "value": "parallax-up", "label": "Parallax drift" },
        { "value": "fixed", "label": "Fixed" },
        { "value": "fade", "label": "Fade in" }
      ]
    },
    {
      "type": "select", "id": "height", "label": "t:sections.hero.height", "default": "large",
      "options": [
        { "value": "slim", "label": "Slim bar" },
        { "value": "small", "label": "t:options.height.small" },
        { "value": "medium", "label": "t:options.height.medium" },
        { "value": "large", "label": "t:options.height.large" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.eyebrow", "default": "Melbourne workshop" },
    { "type": "text", "id": "heading", "label": "t:sections.hero.heading", "default": "One stop differential service solution" },
    { "type": "textarea", "id": "text", "label": "t:sections.hero.text", "default": "Diff repairs, servicing, 9″ conversions, custom axles and fabrication, built by specialists." },
    { "type": "text", "id": "primary_label", "label": "t:sections.hero.primary_label", "default": "Book a service" },
    { "type": "url", "id": "primary_link", "label": "t:sections.hero.primary_link" },
    { "type": "text", "id": "secondary_label", "label": "t:sections.hero.secondary_label", "default": "Shop parts" },
    { "type": "url", "id": "secondary_link", "label": "t:sections.hero.secondary_link" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust point",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "gear", "label": "Gear" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "1yr / 20,000km warranty" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [
        { "type": "trust", "settings": { "icon": "shield", "text": "1yr / 20,000km warranty" } },
        { "type": "trust", "settings": { "icon": "truck", "text": "Shipped Australia wide" } },
        { "type": "trust", "settings": { "icon": "clock", "text": "Same-day service available" } }
      ]
    }
  ]
}
{% endschema %}
