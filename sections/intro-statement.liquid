{%- liquid
  assign scheme_class = ''
  if section.settings.color_scheme == 'alt'
    assign scheme_class = ' surface-alt'
  elsif section.settings.color_scheme == 'dark'
    assign scheme_class = ' surface-dark'
  endif
  if section.settings.background_image != blank
    if section.settings.bg_overlay_color == 'light'
      assign scheme_class = ' has-section-media surface-alt'
    else
      assign scheme_class = ' has-section-media surface-dark'
    endif
  endif
-%}

<div class="section intro-statement{{ scheme_class }}">
  {% render 'section-media', s: section.settings %}
  <div class="page-width">
    <div class="intro-statement__grid">
      <div class="intro-statement__aside">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="intro-statement__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button {% if section.settings.color_scheme == 'dark' %}button--primary{% else %}button--dark{% endif %} intro-statement__cta">
            {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 16 %}
          </a>
        {%- endif -%}
      </div>

      <div class="intro-statement__body">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'lead' -%}
              <p class="intro-statement__lead" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- when 'paragraph' -%}
              <div class="rte intro-statement__rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank or section.settings.stat_3_value != blank -%}
          <div class="intro-statement__stats">
            {%- if section.settings.stat_1_value != blank -%}
              <div><span>{{ section.settings.stat_1_value }}</span>{{ section.settings.stat_1_label }}</div>
            {%- endif -%}
            {%- if section.settings.stat_2_value != blank -%}
              <div><span>{{ section.settings.stat_2_value }}</span>{{ section.settings.stat_2_label }}</div>
            {%- endif -%}
            {%- if section.settings.stat_3_value != blank -%}
              <div><span>{{ section.settings.stat_3_value }}</span>{{ section.settings.stat_3_label }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .intro-statement__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
  @media (min-width: 850px) {
    .intro-statement__grid {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }
  }
  .intro-statement__aside { margin-bottom: 0; }
  .intro-statement__heading {
    margin: 0;
    padding-left: 1.1rem;
    border-left: 4px solid rgb(var(--color-primary));
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
    line-height: 1.1;
  }
  .intro-statement__cta { margin-top: 1.5rem; }

  .intro-statement__body { max-width: 44rem; }
  .intro-statement__lead {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.012em;
    margin: 0 0 1.5rem;
  }
  .surface-dark .intro-statement__lead { color: #fff; }
  .intro-statement__rte { color: rgb(var(--color-text) / 0.78); }
  .surface-dark .intro-statement__rte { color: rgb(255 255 255 / 0.75); }
  .intro-statement__rte + .intro-statement__rte { margin-top: 1rem; }

  .intro-statement__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-line));
  }
  .surface-dark .intro-statement__stats { border-color: rgb(255 255 255 / 0.15); }
  .intro-statement__stats > div {
    font-size: 0.82rem;
    line-height: 1.4;
    color: rgb(var(--color-text) / 0.6);
  }
  .surface-dark .intro-statement__stats > div { color: rgb(255 255 255 / 0.6); }
  .intro-statement__stats span {
    display: block;
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: rgb(var(--color-primary));
    margin-bottom: 0.2rem;
  }
  @media (max-width: 599px) {
    .intro-statement__stats { grid-template-columns: 1fr; gap: 1rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Intro statement",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome to Diff King" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One stop differential service solution" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "color_scheme", "label": "Background", "default": "default",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Light grey" },
        { "value": "dark", "label": "Black" }
      ]
    },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Image", "info": "Overrides the background colour above" },
    {
      "type": "select", "id": "bg_effect", "label": "Scroll effect", "default": "parallax-up",
      "options": [
        { "value": "none", "label": "Static" },
        { "value": "parallax-up", "label": "Parallax drift" },
        { "value": "parallax-zoom", "label": "Parallax zoom" },
        { "value": "fixed", "label": "Fixed" },
        { "value": "fade", "label": "Fade in" },
        { "value": "wipe-lr", "label": "Wipe left to right" },
        { "value": "wipe-rl", "label": "Wipe right to left" }
      ]
    },
    {
      "type": "select", "id": "bg_overlay_color", "label": "Overlay tone", "default": "dark",
      "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ]
    },
    { "type": "range", "id": "bg_overlay", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 },
    { "type": "header", "content": "Stats (optional)" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label" }
  ],
  "blocks": [
    {
      "type": "lead",
      "name": "Lead paragraph",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "A differential transfers torque from the engine to the wheels, and lets the wheels turn at different speeds so you keep traction through a corner." }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add supporting detail here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Intro statement",
      "blocks": [
        { "type": "lead" },
        { "type": "paragraph" }
      ]
    }
  ]
}
{% endschema %}
