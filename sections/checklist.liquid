{%- liquid
  assign scheme_class = ''
  if section.settings.color_scheme == 'alt'
    assign scheme_class = ' surface-alt'
  elsif section.settings.color_scheme == 'dark'
    assign scheme_class = ' surface-dark'
  endif
-%}

<div class="section checklist-section{{ scheme_class }}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <ul class="checklist" style="--columns: {{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        <li class="checklist__item" {{ block.shopify_attributes }}>
          <span class="checklist__marker">{% render 'icon', name: section.settings.icon, size: 16 %}</span>
          <span class="checklist__text">
            {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong> {% endif -%}
            {{ block.settings.text }}
          </span>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button {% if section.settings.color_scheme == 'dark' %}button--primary{% else %}button--dark{% endif %} checklist__cta">
        {{ section.settings.button_label }} {% render 'icon', name: 'arrow-right', size: 16 %}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgb(var(--color-line));
    border: 1px solid rgb(var(--color-line));
    border-radius: var(--border-radius);
    overflow: hidden;
  }
  .surface-dark .checklist { background: rgb(255 255 255 / 0.14); border-color: rgb(255 255 255 / 0.14); }
  @media (min-width: 800px) {
    .checklist { grid-template-columns: repeat(var(--columns), 1fr); }
  }
  .checklist__item {
    display: flex;
    gap: 0.9rem;
    padding: 1.15rem 1.35rem;
    background: rgb(var(--color-background));
  }
  .surface-alt .checklist__item { background: rgb(var(--color-surface)); }
  .surface-dark .checklist__item { background: rgb(var(--color-dark)); }
  .checklist__marker {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
    margin-top: 0.05rem;
    border-radius: 999px;
    background: rgb(var(--color-primary) / 0.14);
    color: rgb(var(--color-primary));
  }
  .surface-dark .checklist__marker { background: rgb(var(--color-primary) / 0.22); }
  .checklist__text { font-size: 0.95rem; line-height: 1.55; }
  .checklist__text strong { font-weight: 700; }
  .surface-dark .checklist__text { color: rgb(255 255 255 / 0.8); }
  .checklist__cta { margin-top: 2rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Checklist",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Checklist" },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "select", "id": "icon", "label": "Item icon", "default": "spark",
      "options": [
        { "value": "spark", "label": "Spark" },
        { "value": "wrench", "label": "Wrench" },
        { "value": "gear", "label": "Gear" },
        { "value": "shield", "label": "Shield" },
        { "value": "chevron-right", "label": "Chevron" }
      ]
    },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "color_scheme", "label": "Background", "default": "alt",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Light grey" },
        { "value": "dark", "label": "Black" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Lead-in (optional, bold)" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Checklist item." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Checklist",
      "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ]
    }
  ]
}
{% endschema %}
