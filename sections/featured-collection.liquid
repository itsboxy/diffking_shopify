{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign has_products = false
  if collection != blank and collection.products_count > 0
    assign has_products = true
  endif
-%}

{%- if has_products or request.design_mode -%}
<div class="section featured-collection{% if section.settings.color_scheme == 'alt' %} surface-alt{% elsif section.settings.color_scheme == 'dark' %} surface-dark{% endif %}">
  <div class="page-width">
    <div class="featured-collection__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | default: collection.title }}</h2>
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="text-link featured-collection__all small-hide">
          {{ 'sections.featured_collection.view_all' | t }} {% render 'icon', name: 'arrow-right', size: 15 %}
        </a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="product-grid product-grid--{{ section.settings.columns }}">
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid product-grid--{{ section.settings.columns }}">
        {%- for i in (1..limit) -%}
          <div class="card">
            <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <p class="card__vendor">Diff King</p>
            <h3 class="card__title"><a href="#">Example product</a></h3>
            <div class="card__price">$0.00</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection != blank -%}
      <a href="{{ collection.url }}" class="button button--secondary featured-collection__all-btn medium-hide">
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .featured-collection__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .featured-collection__head h2 { margin: 0; }
  .featured-collection__all-btn { display: none; margin-top: 2rem; width: 100%; }
  .placeholder-svg { width: 100%; height: 100%; }
  @media (max-width: 989px) {
    .featured-collection__all-btn { display: flex; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the shop" },
    { "type": "text", "id": "heading", "label": "t:sections.featured_collection.heading", "default": "Shop diff parts" },
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.collection" },
    { "type": "range", "id": "products_to_show", "label": "t:sections.featured_collection.products_to_show", "min": 2, "max": 12, "step": 1, "default": 4 },
    {
      "type": "select", "id": "columns", "label": "t:sections.featured_collection.columns", "default": "4",
      "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ]
    },
    { "type": "checkbox", "id": "show_view_all", "label": "t:sections.featured_collection.show_view_all", "default": true },
    {
      "type": "select", "id": "color_scheme", "label": "Background", "default": "default",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Light grey" },
        { "value": "dark", "label": "Black" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
