{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<div class="section featured-collection">
  <div class="page-width">
    <div class="featured-collection__head">
      <h2>{{ section.settings.heading | default: collection.title }}</h2>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="button button--secondary">{{ 'sections.featured_collection.view_all' | t }}</a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="product-grid product-grid--{{ section.settings.columns }}">
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid product-grid--{{ section.settings.columns }}">
        {%- for i in (1..limit) -%}
          <div class="card">
            <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'card__placeholder' }}</div>
            <h3 class="card__title"><a href="#">Example product</a></h3>
            <div class="card__price">$0.00</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .featured-collection__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .featured-collection__head h2 { margin: 0; }
  .card__placeholder { width: 100%; height: 100%; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.heading",
      "default": "Shop diff parts"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.featured_collection.columns",
      "default": "4",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.show_view_all",
      "default": true
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
