{%- liquid
  assign bg = section.settings.background_image
  assign wrap_class = ' surface-alt'
  if bg != blank
    if section.settings.bg_overlay_color == 'light'
      assign wrap_class = ' has-section-media surface-alt'
    else
      assign wrap_class = ' has-section-media surface-dark'
    endif
  endif
-%}
<div class="section services{{ wrap_class }}">
  {% render 'section-media', s: section.settings %}
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="services__grid" style="--columns: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }}
          class="service-card"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="service-card__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="service-card__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="service-card__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.link != blank -%}
            <span class="text-link service-card__more">Learn more {% render 'icon', name: 'arrow-right', size: 15 %}</span>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .services.has-section-media .eyebrow { color: rgb(var(--color-primary)); }
  .services.has-section-media .service-card { color: rgb(var(--color-text)); }

  .services__grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 700px) { .services__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .services__grid { grid-template-columns: repeat(var(--columns), 1fr); } }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: calc(2rem - 2px) 1.85rem 2rem;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-line));
    border-top: 3px solid rgb(var(--color-line));
    border-radius: var(--border-radius);
    text-decoration: none;
    color: inherit;
    transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease),
      border-color 0.22s var(--ease), border-top-color 0.22s var(--ease);
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: rgb(var(--color-primary) / 0.35);
    border-top-color: rgb(var(--color-primary));
  }

  .service-card__index {
    font-family: var(--font-heading), sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: rgb(var(--color-primary));
  }
  .service-card__title { margin: 0.75rem 0 0; font-size: 1.1rem; }
  .service-card__text { margin: 0; color: rgb(var(--color-text) / 0.7); font-size: 0.92rem; line-height: 1.55; }
  .service-card__more { margin-top: auto; padding-top: 0.6rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.services.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we do" },
    { "type": "text", "id": "heading", "label": "t:sections.services.heading", "default": "Our services" },
    { "type": "textarea", "id": "text", "label": "t:sections.services.text", "default": "Everything under one roof, backed by a 1 year / 20,000 km workmanship warranty." },
    { "type": "range", "id": "columns", "label": "t:sections.services.columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Image", "info": "Sits behind the cards" },
    {
      "type": "select", "id": "bg_effect", "label": "Scroll effect", "default": "wipe-lr",
      "options": [
        { "value": "none", "label": "Static" },
        { "value": "parallax-up", "label": "Parallax drift" },
        { "value": "parallax-zoom", "label": "Parallax zoom" },
        { "value": "fixed", "label": "Fixed" },
        { "value": "fade", "label": "Fade in" },
        { "value": "wipe-lr", "label": "Wipe left to right" },
        { "value": "wipe-rl", "label": "Wipe right to left" }
      ]
    },
    {
      "type": "select", "id": "bg_overlay_color", "label": "Overlay tone", "default": "dark",
      "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ]
    },
    { "type": "range", "id": "bg_overlay", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 40 }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "t:sections.service_item.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.service_item.title", "default": "Service title" },
        { "type": "textarea", "id": "text", "label": "t:sections.service_item.text", "default": "Short description of this service." },
        { "type": "url", "id": "link", "label": "t:sections.service_item.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.services.name",
      "blocks": [
        { "type": "service", "settings": { "title": "Diff repairs & service", "text": "Same-day diff repair and service for all makes and models." } },
        { "type": "service", "settings": { "title": "9″ conversions", "text": "Complete 9 inch diff conversions with LSD & spool options." } },
        { "type": "service", "settings": { "title": "Custom build diffs & axles", "text": "Custom differential components and axles at competitive prices." } },
        { "type": "service", "settings": { "title": "Tail shafts & balancing", "text": "Custom-built tail shafts, recondition, repair and balancing." } },
        { "type": "service", "settings": { "title": "Changeover diffs & ratios", "text": "Reconditioned diffs and gear ratios ready for changeover." } },
        { "type": "service", "settings": { "title": "Diff spares shop", "text": "Quality differential components and second hand parts." } }
      ]
    }
  ]
}
{% endschema %}
