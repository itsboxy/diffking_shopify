<div class="section services surface-alt">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="services__grid" style="--columns: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }}
          class="service-card"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="service-card__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="service-card__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</span>
          <h3 class="service-card__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="service-card__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.link != blank -%}
            <span class="text-link service-card__more">Learn more {% render 'icon', name: 'arrow-right', size: 15 %}</span>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .services__grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 700px) { .services__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .services__grid { grid-template-columns: repeat(var(--columns), 1fr); } }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: calc(2rem - 2px) 1.85rem 2rem;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-line));
    border-top: 3px solid rgb(var(--color-line));
    border-radius: var(--border-radius);
    text-decoration: none;
    color: inherit;
    transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease),
      border-color 0.22s var(--ease), border-top-color 0.22s var(--ease);
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: rgb(var(--color-primary) / 0.35);
    border-top-color: rgb(var(--color-primary));
  }

  .service-card__index {
    font-family: var(--font-heading), sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: rgb(var(--color-text) / 0.3);
  }
  .service-card__icon {
    display: grid; place-items: center;
    width: 3rem; height: 3rem;
    margin-top: 0.25rem;
    border-radius: var(--border-radius-sm);
    background: rgb(var(--color-primary) / 0.1);
    color: rgb(var(--color-primary-dark));
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease);
  }
  .service-card:hover .service-card__icon { background: rgb(var(--color-primary)); color: rgb(var(--color-primary-contrast)); }
  .service-card__title { margin: 0.4rem 0 0; font-size: 1.1rem; }
  .service-card__text { margin: 0; color: rgb(var(--color-text) / 0.7); font-size: 0.92rem; line-height: 1.55; }
  .service-card__more { margin-top: auto; padding-top: 0.6rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.services.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we do" },
    { "type": "text", "id": "heading", "label": "t:sections.services.heading", "default": "Our services" },
    { "type": "textarea", "id": "text", "label": "t:sections.services.text", "default": "Everything under one roof, backed by a 1 year / 20,000 km workmanship warranty." },
    { "type": "range", "id": "columns", "label": "t:sections.services.columns", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "t:sections.service_item.name",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "t:sections.service_item.icon", "default": "wrench",
          "options": [
            { "value": "wrench", "label": "Wrench" },
            { "value": "gear", "label": "Gear" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "spark", "label": "Spark" }
          ]
        },
        { "type": "text", "id": "title", "label": "t:sections.service_item.title", "default": "Service title" },
        { "type": "textarea", "id": "text", "label": "t:sections.service_item.text", "default": "Short description of this service." },
        { "type": "url", "id": "link", "label": "t:sections.service_item.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.services.name",
      "blocks": [
        { "type": "service", "settings": { "icon": "wrench", "title": "Diff repairs & service", "text": "Same-day diff repair and service for all makes and models." } },
        { "type": "service", "settings": { "icon": "gear", "title": "9″ conversions", "text": "Complete 9 inch diff conversions with LSD & spool options." } },
        { "type": "service", "settings": { "icon": "gear", "title": "Custom build diffs & axles", "text": "Custom differential components and axles at competitive prices." } },
        { "type": "service", "settings": { "icon": "spark", "title": "Tail shafts & balancing", "text": "Custom-built tail shafts, recondition, repair and balancing." } },
        { "type": "service", "settings": { "icon": "truck", "title": "Changeover diffs & ratios", "text": "Reconditioned diffs and gear ratios ready for changeover." } },
        { "type": "service", "settings": { "icon": "shield", "title": "Diff spares shop", "text": "Quality differential components and second hand parts." } }
      ]
    }
  ]
}
{% endschema %}
