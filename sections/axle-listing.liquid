{%- assign rows = data | strip | split: '
' -%}

<div class="section axle-listing{% if section.settings.color_scheme == 'alt' %} surface-alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.diagram != blank -%}
      <figure class="axle-listing__diagram">
        {{ section.settings.diagram | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 900px) 60vw, 100vw', alt: 'Axle dimension diagram' }}
        {%- if section.settings.diagram_caption != blank -%}<figcaption>{{ section.settings.diagram_caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}

    <div class="axle-listing__tools">
      <label class="field axle-listing__search">
        <span class="visually-hidden">Search axles</span>
        <input type="search" data-axle-search placeholder="Search by name, drawing number or pattern" autocomplete="off">
      </label>
      <p class="axle-listing__count" data-axle-count>{{ rows.size }} axles</p>
    </div>

    <div class="axle-listing__scroll">
      <table class="axle-table" data-axle-table>
        <thead>
          <tr>
            <th scope="col">Item name</th>
            <th scope="col">Drawing no.</th>
            <th scope="col">Stud pattern</th>
            <th scope="col">Flange PCD / Ø</th>
            <th scope="col">B</th>
            <th scope="col">C&nbsp;Ø</th>
            <th scope="col">A&nbsp;Ø</th>
            <th scope="col">I</th>
            <th scope="col">H&nbsp;Ø</th>
            <th scope="col">G</th>
            <th scope="col">D</th>
            <th scope="col">Spline</th>
            <th scope="col">Length (E)</th>
          </tr>
        </thead>
        <tbody>
          {%- for row in rows -%}
            {%- assign c = row | split: '|' -%}
            <tr data-axle-row data-search="{{ c[0] | downcase | escape }} {{ c[1] | escape }} {{ c[11] | downcase }}">
              <th scope="row">{{ c[0] }}</th>
              <td>{{ c[1] }}</td>
              <td>{{ c[2] | replace: '~', '<br>' }}</td>
              <td>{{ c[3] | replace: '~', '<br>' }}</td>
              <td>{{ c[4] }}</td>
              <td>{{ c[5] }}</td>
              <td>{{ c[6] }}</td>
              <td>{{ c[7] }}</td>
              <td>{{ c[8] }}</td>
              <td>{{ c[9] }}</td>
              <td>{{ c[10] }}</td>
              <td>{{ c[11] }}</td>
              <td>{{ c[12] | replace: '~', '<br>' }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <p class="axle-listing__empty" data-axle-empty hidden>No axles match that search.</p>
    </div>

    {%- if section.settings.legend != blank -%}
      <div class="axle-listing__legend rte">{{ section.settings.legend }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .axle-listing__diagram { margin: 0 0 2rem; max-width: 46rem; }
  .axle-listing__diagram img { width: 100%; border: 1px solid rgb(var(--color-line)); border-radius: var(--border-radius); }
  .axle-listing__diagram figcaption { margin-top: 0.5rem; font-size: 0.82rem; color: rgb(var(--color-text) / 0.6); }

  .axle-listing__tools {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.75rem 1.5rem; margin-bottom: 1rem;
  }
  .axle-listing__search { flex: 1 1 20rem; max-width: 28rem; margin: 0; }
  .axle-listing__count { margin: 0; font-size: 0.85rem; color: rgb(var(--color-text) / 0.6); }

  .axle-listing__scroll {
    overflow-x: auto;
    border: 1px solid rgb(var(--color-line));
    border-radius: var(--border-radius);
    -webkit-overflow-scrolling: touch;
  }
  .axle-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
    white-space: nowrap;
  }
  .axle-table thead th {
    position: sticky; top: 0;
    background: rgb(var(--color-dark));
    color: #fff;
    font-family: var(--font-heading), sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-align: left;
    padding: 0.7rem 0.85rem;
    z-index: 2;
  }
  .axle-table tbody th,
  .axle-table tbody td {
    padding: 0.7rem 0.85rem;
    border-top: 1px solid rgb(var(--color-line));
    vertical-align: top;
    line-height: 1.4;
  }
  .axle-table tbody th {
    position: sticky; left: 0;
    background: rgb(var(--color-background));
    text-align: left;
    font-weight: 700;
    white-space: normal;
    min-width: 12rem;
    z-index: 1;
    border-right: 1px solid rgb(var(--color-line));
  }
  .surface-alt .axle-table tbody th { background: rgb(var(--color-surface)); }
  .axle-table tbody tr:hover td,
  .axle-table tbody tr:hover th { background: rgb(var(--color-primary) / 0.05); }
  .axle-table td:nth-child(3),
  .axle-table td:nth-child(4),
  .axle-table td:last-child { white-space: normal; min-width: 9rem; }

  .axle-listing__empty { padding: 2rem; text-align: center; color: rgb(var(--color-text) / 0.6); }
  .axle-listing__legend { margin-top: 1.25rem; font-size: 0.85rem; color: rgb(var(--color-text) / 0.7); }
{% endstylesheet %}

{% javascript %}
  (function () {
    var wraps = document.querySelectorAll('.axle-listing');
    [].forEach.call(wraps, function (wrap) {
      var input = wrap.querySelector('[data-axle-search]');
      var rows = [].slice.call(wrap.querySelectorAll('[data-axle-row]'));
      var count = wrap.querySelector('[data-axle-count]');
      var empty = wrap.querySelector('[data-axle-empty]');
      if (!input) return;
      var total = rows.length;
      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        var shown = 0;
        rows.forEach(function (r) {
          var hit = !q || (r.getAttribute('data-search') || '').indexOf(q) !== -1;
          r.hidden = !hit;
          if (hit) shown++;
        });
        if (count) count.textContent = q ? shown + ' of ' + total + ' axles' : total + ' axles';
        if (empty) empty.hidden = shown !== 0;
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Axle listing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Axle listing" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drawing numbers and dimensions for our custom axle blanks. Lengths are L (long), M (medium) and S (short) sides. Talk to us for anything not listed." },
    { "type": "image_picker", "id": "diagram", "label": "Dimension diagram", "info": "The axle drawing showing the A to I callouts" },
    { "type": "text", "id": "diagram_caption", "label": "Diagram caption", "default": "Dimension reference for the table below" },
    { "type": "richtext", "id": "legend", "label": "Legend / notes", "default": "<p>All dimensions in mm. Ø is diameter. SP is spline count. PCD is pitch circle diameter.</p>" },
    {
      "type": "select", "id": "color_scheme", "label": "Background", "default": "default",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Light grey" }
      ]
    }
  ],
  "presets": [{ "name": "Axle listing" }]
}
{% endschema %}
