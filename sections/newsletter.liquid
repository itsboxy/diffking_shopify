<div class="section newsletter-section surface-dark">
  <div class="page-width newsletter-section__inner">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}

    {% form 'customer', class: 'newsletter-form' %}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" data-form-status>{{ 'general.newsletter_form.confirmation' | t }}</p>
      {%- endif -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__row newsletter-form__row--center">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
        <input type="email" name="contact[email]" id="NewsletterEmail" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" autocomplete="email" required>
        <button type="submit" class="button button--primary">{{ 'general.newsletter_form.subscribe' | t }}</button>
      </div>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .newsletter-section__inner { max-width: 40rem; margin-inline: auto; text-align: center; }
  .newsletter-section__inner p { color: rgb(255 255 255 / 0.72); }
  .newsletter-form__row--center { max-width: 26rem; margin-inline: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.heading",
      "default": "Get diff tips & workshop offers"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.newsletter.text",
      "default": "Occasional emails on builds, ratios and specials. No spam."
    }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
