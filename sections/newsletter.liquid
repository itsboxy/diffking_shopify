<div class="section newsletter-section surface-dark">
  <div class="page-width newsletter-section__inner">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}

    {% form 'customer', class: 'newsletter-form' %}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" data-form-status>{{ 'general.newsletter_form.confirmation' | t }}</p>
      {%- endif -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__row">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
        <input type="email" name="contact[email]" id="NewsletterEmail" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" autocomplete="email" required>
        <button type="submit" class="button button--primary">{{ 'general.newsletter_form.subscribe' | t }}</button>
      </div>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .newsletter-section__inner { max-width: 42rem; margin-inline: auto; text-align: center; }
  .newsletter-section__inner .eyebrow { justify-content: center; }
  .newsletter-section__inner p { color: rgb(255 255 255 / 0.72); margin-bottom: 1.75rem; }
  .newsletter-form__row { display: flex; gap: 0.5rem; max-width: 27rem; margin-inline: auto; flex-wrap: wrap; }
  .newsletter-form__row input {
    flex: 1 1 12rem;
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.25);
    color: #fff;
  }
  .newsletter-form__row input::placeholder { color: rgb(255 255 255 / 0.5); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "t:sections.newsletter.heading", "default": "Get diff tips & workshop offers" },
    { "type": "textarea", "id": "text", "label": "t:sections.newsletter.text", "default": "Occasional emails on builds, ratios and specials. No spam." }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
