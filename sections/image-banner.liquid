{%- liquid
  assign src = ''
  if section.settings.image != blank
    assign src = section.settings.image | image_url: width: 2400
  elsif section.settings.asset_image != blank
    assign src = section.settings.asset_image | asset_url
  endif
-%}

{%- if src != '' -%}
  <div class="image-banner{% if section.settings.constrain %} image-banner--constrained{% endif %}">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt | escape }}
    {%- else -%}
      {%- # theme-check-disable RemoteAsset, ImgWidthAndHeight -%}
      <img src="{{ src }}" alt="{{ section.settings.alt | escape }}" width="{{ section.settings.asset_width | default: 1920 }}" height="{{ section.settings.asset_height | default: 820 }}" loading="lazy">
      {%- # theme-check-enable RemoteAsset, ImgWidthAndHeight -%}
    {%- endif -%}
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .image-banner { line-height: 0; }
  .image-banner img { width: 100%; height: auto; }
  .image-banner--constrained { max-width: var(--page-width); margin-inline: auto; padding-inline: var(--gutter); }
  .image-banner--constrained img { border-radius: var(--border-radius); }
{% endstylesheet %}

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset_image", "label": "Bundled image file", "info": "Used when no image is picked. Filename in assets/ (e.g. disc-trac-banner.jpg)" },
    { "type": "number", "id": "asset_width", "label": "Bundled image width (px)" },
    { "type": "number", "id": "asset_height", "label": "Bundled image height (px)" },
    { "type": "text", "id": "alt", "label": "Alt text" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "constrain", "label": "Constrain to page width", "default": false }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
