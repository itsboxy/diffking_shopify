<section class="dt-hero">
  <div class="dt-hero__main">
    <div class="page-width dt-hero__inner">
      <div class="dt-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="dt-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="dt-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="dt-hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '/pages/contact' }}" class="button button--primary dt-hero__cta">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
    <span class="dt-hero__wedge" aria-hidden="true"></span>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="dt-hero__strip">
      <ul class="page-width dt-hero__badges" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="dt-hero__badge-icon">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
            <span class="dt-hero__badge-label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .dt-hero { background: #000; color: #fff; }

  .dt-hero__main {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .dt-hero__wedge {
    position: absolute;
    top: 0; bottom: 0; right: 0;
    width: 42%;
    background: rgb(var(--color-primary));
    clip-path: polygon(28% 0, 100% 0, 100% 100%, 0% 100%);
    z-index: -1;
  }
  @media (max-width: 749px) {
    .dt-hero__wedge { width: 100%; height: 0.5rem; top: auto; bottom: 0; clip-path: none; }
  }

  .dt-hero__inner { padding-block: clamp(3rem, 8vw, 6rem); }
  .dt-hero__content { max-width: 40rem; }

  .dt-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-heading), sans-serif;
    font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
    margin-bottom: 1rem;
  }
  .dt-hero__heading {
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: rgb(var(--color-primary));
    margin: 0 0 1.5rem;
  }
  .dt-hero__text {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.85);
    max-width: 34ch;
    margin: 0 0 2rem;
  }
  .dt-hero__cta { padding-inline: 2.4rem; }

  .dt-hero__strip { background: rgb(var(--color-primary)); }
  .dt-hero__badges {
    list-style: none;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.5rem;
  }
  .dt-hero__badges li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 8rem;
    text-align: center;
    color: rgb(var(--color-primary-contrast));
  }
  .dt-hero__badge-icon {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 2px solid rgb(var(--color-primary-contrast) / 0.9);
    border-radius: 999px;
  }
  .dt-hero__badge-label {
    font-family: var(--font-heading), sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Disc Trac hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Diff King engineering" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Disc Trac helical LSD" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ultimate traction from a forged 20MnCr5 casing, a 7 helical gear system, hardened 45 to 50 HRC." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get a quote" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to /pages/contact" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "gear",
          "options": [
            { "value": "gear", "label": "Gear" },
            { "value": "shield", "label": "Shield" },
            { "value": "spark", "label": "Spark" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "truck", "label": "Truck" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Feature" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Disc Trac hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "gear", "label": "50/50 power distribution" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "20MnCr5 material" } },
        { "type": "badge", "settings": { "icon": "spark", "label": "Highly customisable" } },
        { "type": "badge", "settings": { "icon": "gear", "label": "7 pinion gears" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "Patented design" } }
      ]
    }
  ]
}
{% endschema %}
