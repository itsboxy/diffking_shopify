{%- liquid
  assign scheme = section.settings.color_scheme
  assign wrap_class = ''
  if scheme == 'alt'
    assign wrap_class = ' surface-alt'
  elsif scheme == 'dark'
    assign wrap_class = ' surface-dark'
  endif
  assign has_media = false
  if section.settings.background_image != blank
    assign has_media = true
    if section.settings.bg_overlay_color == 'light'
      assign wrap_class = ' has-section-media surface-alt'
    else
      assign wrap_class = ' has-section-media surface-dark'
    endif
  endif
-%}

<div class="section cta-banner{{ wrap_class }}{% if scheme == 'accent' and has_media == false %} cta-banner--accent{% endif %}">
  {% render 'section-media', s: section.settings %}
  <div class="page-width">
    <div class="cta-banner__inner">
      <div class="cta-banner__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="cta-banner__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="cta-banner__lede">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
        <div class="cta-banner__actions">
          {%- if section.settings.primary_label != blank -%}
            <a href="{{ section.settings.primary_link | default: '/pages/contact' }}" class="button {% if scheme == 'accent' or scheme == 'dark' %}button--light{% else %}button--primary{% endif %}">
              {{ section.settings.primary_label }} {% render 'icon', name: 'arrow-right', size: 16 %}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a href="{{ section.settings.secondary_link | default: '#' }}" class="button button--secondary{% if scheme == 'accent' or scheme == 'dark' %} button--on-dark{% endif %}">{{ section.settings.secondary_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .cta-banner--accent {
    background: rgb(var(--color-primary));
    color: rgb(var(--color-primary-contrast));
  }
  .cta-banner--accent .eyebrow { color: rgb(var(--color-primary-contrast) / 0.8); }
  .cta-banner--accent .eyebrow::before { background: rgb(var(--color-primary-contrast) / 0.6); }
  .cta-banner--accent .cta-banner__heading { color: rgb(var(--color-primary-contrast)); }
  .cta-banner--accent .cta-banner__lede { color: rgb(var(--color-primary-contrast) / 0.85); }

  .cta-banner__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  @media (min-width: 850px) {
    .cta-banner__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }
  .cta-banner__heading { margin: 0 0 0.5rem; font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .cta-banner__lede { margin: 0; max-width: 48ch; color: rgb(var(--color-text) / 0.7); }
  .surface-dark .cta-banner__lede { color: rgb(255 255 255 / 0.75); }
  .cta-banner__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; flex-shrink: 0; }

  .button--light { background: rgb(var(--color-background)); color: rgb(var(--color-text)); border-color: rgb(var(--color-background)); }
  .button--light:hover { background: rgb(var(--color-surface)); border-color: rgb(var(--color-surface)); }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to get a quote?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Call the workshop or send your details and we will come back with pricing and lead time." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Get a quote" },
    { "type": "url", "id": "primary_link", "label": "Primary link", "info": "Defaults to /pages/contact" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    {
      "type": "select", "id": "color_scheme", "label": "Background", "default": "accent",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Light grey" },
        { "value": "accent", "label": "Red" },
        { "value": "dark", "label": "Black" }
      ]
    },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Image", "info": "Overrides the background colour" },
    {
      "type": "select", "id": "bg_effect", "label": "Scroll effect", "default": "parallax-up",
      "options": [
        { "value": "none", "label": "Static" },
        { "value": "parallax-up", "label": "Parallax drift" },
        { "value": "parallax-zoom", "label": "Parallax zoom" },
        { "value": "fixed", "label": "Fixed" },
        { "value": "fade", "label": "Fade in" },
        { "value": "wipe-lr", "label": "Wipe left to right" },
        { "value": "wipe-rl", "label": "Wipe right to left" }
      ]
    },
    {
      "type": "select", "id": "bg_overlay_color", "label": "Overlay tone", "default": "dark",
      "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ]
    },
    { "type": "range", "id": "bg_overlay", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 }
  ],
  "presets": [{ "name": "CTA banner" }]
}
{% endschema %}
