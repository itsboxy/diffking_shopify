{%- liquid
  assign collection = section.settings.collection
  assign count = section.settings.products_to_show | default: 4
-%}

<section class="hero-feature">
  <div class="page-width">
    <div class="hero-feature__top">
      <div class="hero-feature__intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="hero-feature__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hero-feature__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="hero-feature__actions">
            {%- if section.settings.primary_label != blank -%}
              <a href="{{ section.settings.primary_link | default: '#' }}" class="button button--primary">
                {{ section.settings.primary_label }} {% render 'icon', name: 'arrow-right', size: 16 %}
              </a>
            {%- endif -%}
            {%- if section.settings.secondary_label != blank -%}
              <a href="{{ section.settings.secondary_link | default: '#' }}" class="button button--secondary">{{ section.settings.secondary_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="hero-feature__badges" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="hero-feature__badge-icon">{% render 'icon', name: block.settings.icon, size: 20 %}</span>
              <span class="hero-feature__badge-text">
                <strong>{{ block.settings.label }}</strong>
                {%- if block.settings.sublabel != blank -%}<span>{{ block.settings.sublabel }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.show_products -%}
      <div class="hero-feature__shelf">
        <div class="hero-feature__shelf-head">
          <span class="hero-feature__shelf-title">{{ section.settings.shelf_title | default: 'Featured parts' }}</span>
          {%- if collection != blank -%}
            <a class="hero-feature__shelf-link" href="{{ collection.url }}">{{ 'sections.featured_collection.view_all' | t }} {% render 'icon', name: 'arrow-right', size: 14 %}</a>
          {%- endif -%}
        </div>

        <div class="hero-feature__products">
          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: count -%}
              <a class="hf-card" href="{{ product.url }}">
                <span class="hf-card__media">
                  {%- if product.featured_media -%}
                    {{ product.featured_media | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 400, 500', sizes: '(min-width: 990px) 20vw, 45vw', alt: product.title | escape }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'hf-card__ph' }}
                  {%- endif -%}
                </span>
                <span class="hf-card__title">{{ product.title }}</span>
                <span class="hf-card__price">{% render 'price', product: product, show_from: true %}</span>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..count) -%}
              <span class="hf-card hf-card--ph">
                <span class="hf-card__media">{{ 'product-1' | placeholder_svg_tag: 'hf-card__ph' }}</span>
                <span class="hf-card__title">Example part</span>
                <span class="hf-card__price">$0.00</span>
              </span>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero-feature {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background:
      radial-gradient(60% 50% at 92% 0%, rgb(var(--color-primary) / 0.06) 0%, transparent 60%),
      rgb(var(--color-background));
    border-bottom: 1px solid rgb(var(--color-line));
  }
  .hero-feature__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: end;
  }
  @media (min-width: 950px) {
    .hero-feature__top { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 4rem; }
  }

  .hero-feature__heading {
    font-size: clamp(2.3rem, 5vw, 3.9rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
    margin: 0 0 1.1rem;
    text-wrap: balance;
  }
  .hero-feature__text {
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    color: rgb(var(--color-text) / 0.7);
    max-width: 46ch;
    margin: 0 0 2rem;
  }
  .hero-feature__actions { display: flex; gap: 0.85rem; flex-wrap: wrap; }

  .hero-feature__badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  @media (min-width: 500px) and (max-width: 949px) {
    .hero-feature__badges { grid-template-columns: 1fr 1fr; }
  }
  .hero-feature__badges li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-line));
    border-left: 3px solid rgb(var(--color-primary));
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm);
  }
  .hero-feature__badge-icon {
    display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--border-radius-sm);
    background: rgb(var(--color-primary) / 0.1);
    color: rgb(var(--color-primary-dark));
  }
  .hero-feature__badge-text { display: flex; flex-direction: column; line-height: 1.3; }
  .hero-feature__badge-text strong { font-weight: 600; font-size: 0.95rem; }
  .hero-feature__badge-text span { font-size: 0.82rem; color: rgb(var(--color-text) / 0.55); }

  /* Product shelf */
  .hero-feature__shelf {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--color-line));
  }
  .hero-feature__shelf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .hero-feature__shelf-title {
    font-family: var(--font-heading), sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--color-text) / 0.55);
  }
  .hero-feature__shelf-link {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-family: var(--font-heading), sans-serif;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: rgb(var(--color-primary-dark)); text-decoration: none;
  }
  .hero-feature__shelf-link:hover { color: rgb(var(--color-text)); }

  .hero-feature__products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 700px) { .hero-feature__products { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .hf-card {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-line));
    border-radius: var(--border-radius);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s var(--ease), transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  a.hf-card:hover { border-color: rgb(var(--color-primary)); transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .hf-card__media {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--border-radius-sm);
    background: rgb(var(--color-surface));
    margin-bottom: 0.75rem;
  }
  .hf-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .hf-card__ph { width: 100%; height: 100%; opacity: 0.5; }
  .hf-card__title {
    font-size: 0.88rem;
    line-height: 1.35;
    color: rgb(var(--color-text) / 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hf-card__price {
    margin-top: 0.4rem;
    font-family: var(--font-heading), sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .hf-card--ph { opacity: 0.55; }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero (feature)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Melbourne differential specialists" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Differentials, built and backed by specialists" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Repairs, servicing, 9 inch conversions, custom axles and our own Disc Trac helical LSD. Shipped Australia wide from Dandenong." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Book a service" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Shop parts" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Product shelf" },
    { "type": "checkbox", "id": "show_products", "label": "Show product shelf", "default": true },
    { "type": "text", "id": "shelf_title", "label": "Shelf title", "default": "Featured parts" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "gear", "label": "Gear" },
            { "value": "spark", "label": "Spark" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label", "default": "1 year warranty" },
        { "type": "text", "id": "sublabel", "label": "Sub label", "default": "20,000 km workmanship guarantee" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (feature)",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shield", "label": "1 year warranty", "sublabel": "20,000 km workmanship guarantee" } },
        { "type": "badge", "settings": { "icon": "truck", "label": "Australia wide shipping", "sublabel": "Parts sent nationwide from Dandenong" } },
        { "type": "badge", "settings": { "icon": "clock", "label": "Same day service", "sublabel": "Diff repair and service while you wait" } },
        { "type": "badge", "settings": { "icon": "gear", "label": "9 inch conversions", "sublabel": "Our specialisation since 2007" } }
      ]
    }
  ]
}
{% endschema %}
