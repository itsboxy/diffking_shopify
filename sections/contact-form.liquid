{%- liquid
  assign phone_href = settings.business_phone | remove: ' ' | remove: '(' | remove: ')'
  assign heading_words = section.settings.heading | split: ' '
  assign last_index = heading_words.size | minus: 1
-%}

<div class="section contact-section">
  {%- if section.settings.show_details -%}
    <div class="page-width">
      <ul class="contact-cards" role="list">
        {%- if settings.business_address != blank -%}
          <li class="contact-card contact-card--accent">
            <span class="contact-card__icon">{% render 'icon', name: 'pin', size: 22 %}</span>
            <span class="contact-card__label">Address</span>
            <a class="contact-card__value" href="{{ settings.business_maps_link }}" target="_blank" rel="noopener">{{ settings.business_address }}</a>
          </li>
        {%- endif -%}
        {%- if settings.business_email != blank -%}
          <li class="contact-card">
            <span class="contact-card__icon">{% render 'icon', name: 'mail', size: 22 %}</span>
            <span class="contact-card__label">Email</span>
            <a class="contact-card__value" href="mailto:{{ settings.business_email }}">{{ settings.business_email }}</a>
          </li>
        {%- endif -%}
        {%- if settings.business_phone != blank -%}
          <li class="contact-card">
            <span class="contact-card__icon">{% render 'icon', name: 'phone', size: 22 %}</span>
            <span class="contact-card__label">Phone</span>
            <a class="contact-card__value" href="tel:{{ phone_href }}">{{ settings.business_phone }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <li class="contact-card">
            <span class="contact-card__icon">{% render 'icon', name: 'clock', size: 22 %}</span>
            <span class="contact-card__label">Hours</span>
            <span class="contact-card__value">{{ section.settings.hours }}</span>
          </li>
        {%- endif -%}
      </ul>
    </div>
  {%- endif -%}

  <div class="contact-split">
    <div class="contact-split__map">
      {%- if section.settings.map_embed != blank -%}
        {{ section.settings.map_embed }}
      {%- else -%}
        <a class="contact-split__map-fallback" href="{{ settings.business_maps_link }}" target="_blank" rel="noopener">
          {% render 'icon', name: 'pin', size: 28 %}
          <span>{{ settings.business_address }}</span>
          <span class="contact-split__map-cta">Open in Google Maps {% render 'icon', name: 'arrow-right', size: 15 %}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="contact-split__form">
      <div class="contact-formwrap">
        {%- if section.settings.heading != blank -%}
          <h2 class="contact-formwrap__title">
            {%- for word in heading_words -%}
              {%- if forloop.index0 == last_index -%}<span class="accent">{{ word }}</span>{%- else -%}{{ word }} {% endif -%}
            {%- endfor -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}<p class="contact-formwrap__lede">{{ section.settings.text }}</p>{%- endif -%}

        {% form 'contact', class: 'contact-form' %}
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" data-form-status>{{ 'contact.form.post_success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="form-status form-status--error" data-form-status>
              <p>{{ 'contact.form.error_heading' | t }}</p>
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact-form__row">
            <div class="field">
              <label for="ContactFirst">{{ 'contact.form.first_name' | t }}</label>
              <input type="text" id="ContactFirst" name="contact[name]" value="{{ form.name }}" autocomplete="given-name" required>
            </div>
            <div class="field">
              <label for="ContactLast">{{ 'contact.form.last_name' | t }}</label>
              <input type="text" id="ContactLast" name="contact[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
            </div>
          </div>

          <div class="contact-form__row">
            <div class="field">
              <label for="ContactEmail">{{ 'contact.form.email' | t }}</label>
              <input type="email" id="ContactEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
            </div>
            <div class="field">
              <label for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
              <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
            </div>
          </div>

          <div class="field">
            <label for="ContactMessage">{{ 'contact.form.message' | t }}</label>
            <textarea id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="button button--primary contact-form__submit">{{ 'contact.form.send' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</button>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-section { padding-block: 0; }

  /* Info cards */
  .contact-cards {
    list-style: none;
    margin: 0;
    padding: var(--section-spacing) 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 950px) { .contact-cards { grid-template-columns: repeat(4, 1fr); } }

  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.55rem;
    padding: 2rem 1.5rem;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-line));
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md);
  }
  .contact-card--accent {
    background: rgb(var(--color-primary));
    border-color: rgb(var(--color-primary));
    color: rgb(var(--color-primary-contrast));
  }
  .contact-card__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: rgb(var(--color-dark));
    color: #fff;
  }
  .contact-card--accent .contact-card__icon { background: rgb(var(--color-dark)); }
  .contact-card__label {
    font-family: var(--font-heading), sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .contact-card__value { font-size: 0.9rem; text-decoration: none; font-style: normal; line-height: 1.45; }
  a.contact-card__value:hover { text-decoration: underline; }
  .contact-card--accent a.contact-card__value { color: rgb(var(--color-primary-contrast)); }

  /* Map + form split */
  .contact-split {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: var(--section-spacing);
  }
  @media (min-width: 950px) { .contact-split { grid-template-columns: 1fr 1fr; } }

  .contact-split__map { position: relative; min-height: 340px; background: rgb(var(--color-surface)); }
  .contact-split__map iframe { width: 100%; height: 100%; min-height: 340px; border: 0; display: block; filter: grayscale(0.25) contrast(1.05); }
  .contact-split__map-fallback {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.75rem; padding: 2rem; text-align: center; text-decoration: none;
    color: rgb(var(--color-text));
    background:
      repeating-linear-gradient(45deg, rgb(var(--color-text) / 0.03) 0 12px, transparent 12px 24px),
      rgb(var(--color-surface));
  }
  .contact-split__map-fallback svg { color: rgb(var(--color-primary)); }
  .contact-split__map-cta {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-family: var(--font-heading), sans-serif; font-weight: 700; font-size: 0.8rem;
    letter-spacing: 0.06em; text-transform: uppercase; color: rgb(var(--color-primary-dark));
  }

  .contact-split__form {
    display: flex;
    align-items: center;
    background: rgb(var(--color-surface));
    padding: clamp(2rem, 6vw, 4.5rem) var(--gutter);
  }
  .contact-formwrap { width: 100%; max-width: 40rem; margin-inline: auto; }
  .contact-formwrap__title { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: 0 0 0.5rem; }
  .contact-formwrap__title .accent { color: rgb(var(--color-primary)); }
  .contact-formwrap__lede { color: rgb(var(--color-text) / 0.7); margin-bottom: 1.75rem; }
  .contact-form__row { display: grid; grid-template-columns: 1fr; gap: 0 1rem; }
  @media (min-width: 600px) { .contact-form__row { grid-template-columns: 1fr 1fr; } }
  .contact-formwrap .field input,
  .contact-formwrap .field textarea { background: rgb(var(--color-background)); }
  .contact-form__submit { margin-top: 0.5rem; }
  .contact-form ul { margin: 0.5rem 0 0; padding-left: 1.1rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "settings": [
    { "type": "checkbox", "id": "show_details", "label": "Show info cards", "default": true },
    { "type": "textarea", "id": "hours", "label": "Opening hours", "default": "Mon to Fri, 8:30am to 5:00pm" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "The last word is shown in the accent colour", "default": "Get a free quote" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Call or email, or send the form and we will be happy to help." },
    { "type": "header", "content": "Map" },
    { "type": "html", "id": "map_embed", "label": "Map embed code", "info": "Paste a Google Maps 'Embed a map' iframe. Leave blank to show a link instead." }
  ],
  "presets": [{ "name": "t:sections.contact_form.name" }]
}
{% endschema %}
