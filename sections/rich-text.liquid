<div class="section rich-text">
  <div class="page-width">
    <div class="rich-text__inner rich-text__inner--{{ section.settings.alignment }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <a href="{{ block.settings.link | default: '#' }}" class="button button--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .rich-text__inner {
    max-width: 46rem;
  }
  .rich-text__inner--center { margin-inline: auto; text-align: center; }
  .rich-text__inner--right { margin-left: auto; text-align: right; }
  .rich-text__inner .button { margin-top: 1rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.rich_text.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:blocks.heading.name",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "t:blocks.heading.text", "default": "Rich text heading" }
      ]
    },
    {
      "type": "text",
      "name": "t:blocks.text.name",
      "settings": [
        { "type": "richtext", "id": "text", "label": "t:blocks.text.text", "default": "<p>Use this space to share information about your workshop, services or approach.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "t:blocks.button.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:blocks.button.label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "t:blocks.button.link" },
        {
          "type": "select",
          "id": "style",
          "label": "t:blocks.button.style",
          "default": "primary",
          "options": [
            { "value": "primary", "label": "t:options.button_style.primary" },
            { "value": "secondary", "label": "t:options.button_style.secondary" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
