<div class="section why surface-dark">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="why__grid">
      {%- for block in section.blocks -%}
        <div class="why__item" {{ block.shopify_attributes }}>
          {%- if block.settings.stat != blank -%}
            <span class="why__stat">{{ block.settings.stat }}</span>
          {%- else -%}
            <span class="why__stat why__stat--icon">{% render 'icon', name: 'shield', size: 26 %}</span>
          {%- endif -%}
          <h3 class="why__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="why__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .why .section-heading__eyebrow,
  .why .section-heading p { color: rgb(255 255 255 / 0.7); }
  .why__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 750px) {
    .why__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 990px) {
    .why__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .why__item { text-align: center; }
  .why__stat {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    font-family: var(--font-heading), sans-serif;
    font-size: 2.4rem;
    font-weight: 700;
    color: rgb(var(--color-primary));
  }
  .why__stat--icon {
    width: 3.5rem; height: 3.5rem;
    border-radius: 999px;
    background: rgb(var(--color-primary) / 0.18);
  }
  .why__title { margin: 0.75rem 0 0.35rem; font-size: 1.05rem; }
  .why__text { margin: 0; color: rgb(255 255 255 / 0.7); font-size: 0.9rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.why_choose_us.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.why_choose_us.heading",
      "default": "Why choose Diff King"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Experience, the right equipment, and workmanship you can rely on."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "t:sections.value_item.name",
      "settings": [
        { "type": "text", "id": "stat", "label": "Stat (optional)", "info": "Leave blank to show an icon" },
        { "type": "text", "id": "title", "label": "t:sections.value_item.title", "default": "Value title" },
        { "type": "textarea", "id": "text", "label": "t:sections.value_item.text", "default": "Short supporting sentence." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.why_choose_us.name",
      "blocks": [
        { "type": "value", "settings": { "stat": "1 yr", "title": "Workmanship warranty", "text": "1 year / 20,000 km on all differential work, whichever comes first." } },
        { "type": "value", "settings": { "stat": "AU", "title": "Shipping Australia-wide", "text": "Based in Dandenong, Melbourne — parts shipped nationwide." } },
        { "type": "value", "settings": { "stat": "", "title": "Specialist equipment", "text": "State of the art diagnostic equipment for common and complex problems." } },
        { "type": "value", "settings": { "stat": "100%", "title": "Satisfaction guaranteed", "text": "Friendly, professional differential work every time." } }
      ]
    }
  ]
}
{% endschema %}
