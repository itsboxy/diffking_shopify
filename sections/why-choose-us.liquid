<div class="section why surface-alt">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="why__grid">
      {%- for block in section.blocks -%}
        <div class="why__item" {{ block.shopify_attributes }}>
          <span class="why__stat">
            {%- if block.settings.stat != blank -%}
              {{ block.settings.stat }}
            {%- else -%}
              {% render 'icon', name: 'shield', size: 26 %}
            {%- endif -%}
          </span>
          <h3 class="why__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="why__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .why__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgb(var(--color-line));
    border: 1px solid rgb(var(--color-line));
    border-radius: var(--border-radius);
    overflow: hidden;
  }
  @media (min-width: 600px) { .why__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .why__grid { grid-template-columns: repeat(4, 1fr); } }

  .why__item { padding: 2rem 1.75rem; background: rgb(var(--color-background)); }
  .why__stat {
    display: inline-flex;
    align-items: baseline;
    min-height: 3rem;
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(2rem, 3vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: rgb(var(--color-primary));
    line-height: 1;
  }
  .why__stat svg { align-self: center; }
  .why__title { margin: 1rem 0 0.4rem; font-size: 1.05rem; }
  .why__text { margin: 0; color: rgb(var(--color-text) / 0.68); font-size: 0.9rem; line-height: 1.55; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.why_choose_us.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Diff King" },
    { "type": "text", "id": "heading", "label": "t:sections.why_choose_us.heading", "default": "Workmanship you can rely on" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Experience, the right equipment, and a warranty behind every job." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "t:sections.value_item.name",
      "settings": [
        { "type": "text", "id": "stat", "label": "Stat (optional)", "info": "Leave blank to show an icon" },
        { "type": "text", "id": "title", "label": "t:sections.value_item.title", "default": "Value title" },
        { "type": "textarea", "id": "text", "label": "t:sections.value_item.text", "default": "Short supporting sentence." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.why_choose_us.name",
      "blocks": [
        { "type": "value", "settings": { "stat": "1yr", "title": "Workmanship warranty", "text": "1 year / 20,000 km on all differential work, whichever comes first." } },
        { "type": "value", "settings": { "stat": "AU", "title": "Shipping Australia wide", "text": "Based in Dandenong, Melbourne. Parts shipped nationwide." } },
        { "type": "value", "settings": { "stat": "", "title": "Specialist equipment", "text": "State of the art diagnostic equipment for common and complex problems." } },
        { "type": "value", "settings": { "stat": "100%", "title": "Satisfaction guaranteed", "text": "Friendly, professional differential work every time." } }
      ]
    }
  ]
}
{% endschema %}
