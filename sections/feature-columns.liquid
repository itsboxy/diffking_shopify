{%- liquid
  assign wrap_class = ''
  if section.settings.color_scheme == 'dark'
    assign wrap_class = ' surface-dark'
  elsif section.settings.color_scheme == 'alt'
    assign wrap_class = ' surface-alt'
  endif
  if section.settings.background_image != blank
    if section.settings.bg_overlay_color == 'light'
      assign wrap_class = ' has-section-media surface-alt'
    else
      assign wrap_class = ' has-section-media surface-dark'
    endif
  endif
-%}
<div class="section feature-columns{{ wrap_class }}">
  {% render 'section-media', s: section.settings %}
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-heading section-heading--center">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="feature-columns__grid" style="--columns: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <article class="feature-col" {{ block.shopify_attributes }}>
          <span class="feature-col__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</span>
          <h3 class="feature-col__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="feature-col__text">{{ block.settings.text }}</p>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .feature-columns__grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 700px) { .feature-columns__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .feature-columns__grid { grid-template-columns: repeat(var(--columns), 1fr); } }

  .feature-col {
    padding: calc(2rem - 2px) 1.75rem 2rem;
    border: 1px solid rgb(var(--color-line));
    border-top: 3px solid rgb(var(--color-line));
    border-radius: var(--border-radius);
    background: rgb(var(--color-background));
    transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease),
      border-color 0.22s var(--ease), border-top-color 0.22s var(--ease);
  }
  .feature-col:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: rgb(var(--color-primary) / 0.35);
    border-top-color: rgb(var(--color-primary));
  }
  .surface-dark .feature-col { background: rgb(var(--color-charcoal)); border-color: rgb(255 255 255 / 0.14); border-top-color: rgb(255 255 255 / 0.14); }
  .surface-dark .feature-col:hover { border-top-color: rgb(var(--color-primary)); }
  .feature-col__icon {
    display: grid; place-items: center;
    width: 3rem; height: 3rem;
    border-radius: var(--border-radius-sm);
    background: rgb(var(--color-primary) / 0.1);
    color: rgb(var(--color-primary-dark));
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease);
  }
  .feature-col:hover .feature-col__icon { background: rgb(var(--color-primary)); color: rgb(var(--color-primary-contrast)); }
  .surface-dark .feature-col__icon { background: rgb(var(--color-primary) / 0.18); color: #fff; }
  .surface-dark .feature-col:hover .feature-col__icon { background: rgb(var(--color-primary)); }
  .feature-col__title { margin: 1.1rem 0 0.5rem; font-size: 1.15rem; }
  .surface-dark .feature-col__title { color: #fff; }
  .feature-col__text { margin: 0; color: rgb(var(--color-text) / 0.72); font-size: 0.95rem; line-height: 1.6; }
  .surface-dark .feature-col__text { color: rgb(255 255 255 / 0.72); }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature columns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key features" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select", "id": "color_scheme", "label": "Background", "default": "default",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Light grey" },
        { "value": "dark", "label": "Black" }
      ]
    },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Image", "info": "Overrides the background colour" },
    { "type": "select", "id": "bg_effect", "label": "Scroll effect", "default": "parallax-up", "options": [ { "value": "none", "label": "Static" }, { "value": "parallax-up", "label": "Parallax drift" }, { "value": "parallax-zoom", "label": "Parallax zoom" }, { "value": "fixed", "label": "Fixed" }, { "value": "fade", "label": "Fade in" }, { "value": "wipe-lr", "label": "Wipe left to right" }, { "value": "wipe-rl", "label": "Wipe right to left" } ] },
    { "type": "select", "id": "bg_overlay_color", "label": "Overlay tone", "default": "dark", "options": [ { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" } ] },
    { "type": "range", "id": "bg_overlay", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Feature",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "gear",
          "options": [
            { "value": "gear", "label": "Gear" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "shield", "label": "Shield" },
            { "value": "spark", "label": "Spark" },
            { "value": "truck", "label": "Truck" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this feature." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature columns",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
