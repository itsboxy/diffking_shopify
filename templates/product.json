          "settings": {
            "field_type": "text",
            "label": "Vehicle",
            "placeholder": "Year, make, model",
            "help": "So we can check fitment",
            "required": false
          }
        },
        "diff": {
          "type": "custom_field",
          "settings": {
            "field_type": "text",
