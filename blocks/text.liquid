{% doc %}
  Renders a rich text block.

  @example
  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

<div class="text-block text-block--{{ block.settings.style }}" {{ block.shopify_attributes }}>
  {{ block.settings.text }}
</div>

{% stylesheet %}
  .text-block { margin-bottom: 1rem; }
  .text-block--eyebrow {
    font-family: var(--font-heading), sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-primary));
  }
  .text-block--heading { font-family: var(--font-heading), sans-serif; font-size: calc(1.75rem * var(--heading-scale)); font-weight: 700; line-height: 1.15; }
  .text-block--body { color: rgb(var(--color-text) / 0.8); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.text.name",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.text.text",
      "default": "<p>Share details about your workshop, services or warranty.</p>"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.text.style",
      "default": "body",
      "options": [
        { "value": "eyebrow", "label": "t:options.text_style.eyebrow" },
        { "value": "heading", "label": "t:options.text_style.heading" },
        { "value": "body", "label": "t:options.text_style.body" }
      ]
    }
  ],
  "presets": [{ "name": "t:blocks.text.name" }]
}
{% endschema %}
