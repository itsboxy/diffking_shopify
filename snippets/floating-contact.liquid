{% doc %}
  Renders fixed call and email buttons in the bottom corners of the viewport.

  @example
  {% render 'floating-contact' %}
{% enddoc %}

{%- liquid
  assign phone_href = settings.business_phone | remove: ' ' | remove: '(' | remove: ')'
-%}

{%- if settings.business_email != blank or settings.business_phone != blank -%}
  <div class="floating-contact">
    {%- if settings.business_email != blank -%}
      <a class="floating-contact__btn floating-contact__btn--email" href="mailto:{{ settings.business_email }}" aria-label="{{ 'general.accessibility.email' | t }}">
        {% render 'icon', name: 'mail', size: 22 %}
      </a>
    {%- endif -%}
    {%- if settings.business_phone != blank -%}
      <a class="floating-contact__btn floating-contact__btn--phone" href="tel:{{ phone_href }}" aria-label="{{ 'general.accessibility.phone' | t }}">
        {% render 'icon', name: 'phone', size: 22 %}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .floating-contact { position: fixed; inset: auto 0 0 0; z-index: 40; pointer-events: none; }
  .floating-contact__btn {
    position: fixed;
    bottom: 1.25rem;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    color: #fff;
    box-shadow: var(--shadow-lg);
    pointer-events: auto;
    transition: transform 0.15s var(--ease), background-color 0.15s var(--ease);
  }
  .floating-contact__btn:hover { transform: translateY(-3px); }
  .floating-contact__btn--email { left: 1.25rem; background: rgb(var(--color-dark)); }
  .floating-contact__btn--phone { right: 1.25rem; background: rgb(var(--color-primary)); }
  .floating-contact__btn--phone:hover { background: rgb(var(--color-primary-dark)); }

  @media (max-width: 749px) {
    .floating-contact__btn { width: 3rem; height: 3rem; bottom: 1rem; }
    .floating-contact__btn--email { left: 1rem; }
    .floating-contact__btn--phone { right: 1rem; }
  }
{% endstylesheet %}
