{% doc %}
  Renders a product card for use in product grids.

  @param {product} product - The product to display
  @param {number} [image_width] - Intrinsic image width to request (default 600)

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{%- liquid
  assign image_width = image_width | default: 600
-%}

<div class="card">
  <a class="card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: image_width
        | image_tag:
          loading: 'lazy',
          widths: '300, 400, 600, 800',
          sizes: '(min-width: 990px) 25vw, 50vw',
          alt: product.featured_media.alt | default: product.title | escape
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__placeholder' }}
    {%- endif -%}

    <div class="card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--sold-out">{{ 'products.card.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="badge">{{ 'products.card.sale' | t }}</span>
      {%- endif -%}
    </div>
  </a>

  {%- if product.vendor != blank -%}
    <span class="card__vendor">{{ product.vendor }}</span>
  {%- endif -%}

  <h3 class="card__title">
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>

  <div class="card__price">
    {% render 'price', product: product, show_from: true %}
  </div>
</div>

{% stylesheet %}
  .card__vendor {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-text) / 0.55);
  }
  .card__placeholder {
    width: 100%;
    height: 100%;
    background: rgb(var(--color-text) / 0.06);
  }
{% endstylesheet %}
