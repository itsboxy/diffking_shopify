{% doc %}
  Renders an inline SVG icon by name. Consistent 24px grid, 1.6 stroke.

  @param {string} name - cart, search, menu, close, chevron-down, chevron-right, arrow-right, phone, mail, pin, clock, wrench, gear, truck, shield, spark, check, facebook, instagram, youtube
  @param {number} [size] - Width/height in px (default 24)

  @example
  {% render 'icon', name: 'cart' %}
  {% render 'icon', name: 'phone', size: 16 %}
{% enddoc %}

{%- liquid
  assign size = size | default: 24
-%}

{%- capture attrs -%}viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"{%- endcapture -%}

{%- case name -%}
  {%- when 'cart' -%}
    <svg {{ attrs }}><path d="M3 4h2l2.4 12.2a1.6 1.6 0 0 0 1.6 1.3h8.8a1.6 1.6 0 0 0 1.6-1.3L22 8H6"/><circle cx="9.5" cy="20.5" r="1.4"/><circle cx="18" cy="20.5" r="1.4"/></svg>
  {%- when 'search' -%}
    <svg {{ attrs }}><circle cx="11" cy="11" r="7"/><path d="m20.5 20.5-4-4"/></svg>
  {%- when 'menu' -%}
    <svg {{ attrs }}><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg {{ attrs }}><path d="m6 6 12 12M18 6 6 18"/></svg>
  {%- when 'chevron-down' -%}
    <svg {{ attrs }}><path d="m5 8.5 7 7 7-7"/></svg>
  {%- when 'chevron-right' -%}
    <svg {{ attrs }}><path d="m8.5 5 7 7-7 7"/></svg>
  {%- when 'arrow-right' -%}
    <svg {{ attrs }}><path d="M4 12h15m-6-7 7 7-7 7"/></svg>
  {%- when 'phone' -%}
    <svg {{ attrs }}><path d="M15.5 3.5a5 5 0 0 1 5 5M14.8 6.9a2.2 2.2 0 0 1 1.8 1.8M20.5 16.9v2.6a1.8 1.8 0 0 1-2 1.8 17.8 17.8 0 0 1-7.7-2.7 17.5 17.5 0 0 1-5.4-5.4A17.8 17.8 0 0 1 2.7 5.5a1.8 1.8 0 0 1 1.8-2h2.6a1.8 1.8 0 0 1 1.8 1.5c.1.9.3 1.8.6 2.6a1.8 1.8 0 0 1-.4 1.9l-1.1 1.1a14 14 0 0 0 5.4 5.4l1.1-1.1a1.8 1.8 0 0 1 1.9-.4c.8.3 1.7.5 2.6.6a1.8 1.8 0 0 1 1.5 1.8Z"/></svg>
  {%- when 'mail' -%}
    <svg {{ attrs }}><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 6.5L21 6"/></svg>
  {%- when 'pin' -%}
    <svg {{ attrs }}><path d="M20 10.5c0 5.2-6.3 10.3-7.5 11.2a.8.8 0 0 1-1 0C10.3 20.8 4 15.7 4 10.5a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10.5" r="2.6"/></svg>
  {%- when 'clock' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3.2 1.9"/></svg>
  {%- when 'wrench' -%}
    <svg {{ attrs }}><path d="M15.6 5.2a4.3 4.3 0 0 0-5.6 5.2L4 16.4a2 2 0 1 0 2.8 2.8l5.8-5.8a4.3 4.3 0 0 0 5.2-5.6l-2.7 2.7-2.4-.6-.6-2.4 2.7-2.7Z"/></svg>
  {%- when 'gear' -%}
    <svg {{ attrs }}><path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"/><path d="M19.4 14.5a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5v.2a2 2 0 0 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1h.2a2 2 0 0 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z"/></svg>
  {%- when 'truck' -%}
    <svg {{ attrs }}><path d="M2.5 6.5A1.5 1.5 0 0 1 4 5h9a1.5 1.5 0 0 1 1.5 1.5V16h-12Z"/><path d="M14.5 9h3.8a1.5 1.5 0 0 1 1.2.6l2.2 3a1.5 1.5 0 0 1 .3.9V16h-7.5Z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>
  {%- when 'shield' -%}
    <svg {{ attrs }}><path d="M12 2.5 4.5 5.5v5.6c0 4.7 3.2 7.9 7.5 9.4 4.3-1.5 7.5-4.7 7.5-9.4V5.5Z"/><path d="m8.8 12 2.1 2.1 4.3-4.3"/></svg>
  {%- when 'spark' -%}
    <svg {{ attrs }}><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/></svg>
  {%- when 'check' -%}
    <svg {{ attrs }}><path d="m5 12.5 4.5 4.5L19 7"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13 22v-8h2.7l.4-3H13V9c0-.9.3-1.5 1.6-1.5H16V4.8C15.7 4.8 14.7 4.7 13.6 4.7 11.2 4.7 9.6 6.2 9.6 8.7V11H7v3h2.6v8z"/></svg>
  {%- when 'instagram' -%}
    <svg {{ attrs }}><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22 12s0-3.3-.4-4.8a2.8 2.8 0 0 0-2-2C17.8 5 12 5 12 5s-5.8 0-7.6.5a2.8 2.8 0 0 0-2 2C2 8.7 2 12 2 12s0 3.3.4 4.8a2.8 2.8 0 0 0 2 2C6.2 19 12 19 12 19s5.8 0 7.6-.5a2.8 2.8 0 0 0 2-2C22 15.3 22 12 22 12ZM10 15V9l5 3z"/></svg>
{%- endcase -%}
